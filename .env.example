# Redis connection string (Upstash Redis or Vercel KV)
# Format: redis://default:password@host:port or rediss://... for TLS
REDIS_URL=redis://localhost:6379

# Secret token to protect the /api/scrape endpoint
SCRAPE_SECRET=your_super_secret_token_here

# Optional: Proxy URL for scraping (e.g., BrightData, ScraperAPI)
# PROXY_URL=http://user:pass@proxy.example.com:8080

# Port for local development
PORT=3000
