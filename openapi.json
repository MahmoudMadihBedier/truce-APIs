{
  "openapi": "3.0.0",
  "info": {
    "title": "Egypt Store Scraper API",
    "version": "1.0.0",
    "description": "API for scraping and searching products from major Egyptian retailers."
  },
  "paths": {
    "/api/products": {
      "get": {
        "summary": "Search and filter products",
        "parameters": [
          { "name": "product_name", "in": "query", "schema": { "type": "string" } },
          { "name": "brand_name", "in": "query", "schema": { "type": "string" } },
          { "name": "category", "in": "query", "schema": { "type": "string" } },
          { "name": "store_name", "in": "query", "schema": { "type": "string" } },
          { "name": "product_url", "in": "query", "schema": { "type": "string" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 50 } }
        ],
        "responses": {
          "200": {
            "description": "A list of products",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedProducts"
                }
              }
            }
          }
        }
      }
    },
    "/api/scrape": {
      "post": {
        "summary": "Trigger a full scrape",
        "parameters": [
          { "name": "x-scrape-secret", "in": "header", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Scraping triggered"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Product": {
        "type": "object",
        "required": ["product_name", "product_category", "brand_name", "product_url", "current_price_egp", "product_image_url", "store_name", "availability_status", "last_updated_utc"],
        "properties": {
          "sr_no": { "type": "integer" },
          "product_name": { "type": "string" },
          "product_category": { "type": "string" },
          "brand_name": { "type": "string" },
          "product_url": { "type": "string" },
          "current_price_egp": { "type": "number" },
          "previous_price_egp": { "type": "number", "nullable": true },
          "product_image_url": { "type": "string" },
          "store_name": { "type": "string" },
          "discounts_offers": { "type": "string", "nullable": true },
          "availability_status": { "type": "string", "enum": ["In Stock", "Out of Stock", "Pre-order"] },
          "location_city": { "type": "string", "nullable": true },
          "last_updated_utc": { "type": "string", "format": "date-time" }
        }
      },
      "PaginatedProducts": {
        "type": "object",
        "properties": {
          "products": { "type": "array", "items": { "$ref": "#/components/schemas/Product" } },
          "total_count": { "type": "integer" },
          "timestamp": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
